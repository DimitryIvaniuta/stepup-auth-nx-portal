{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "apps/*/vite.config.ts",
    "apps/*/vitest.config.ts",
    "apps/*/playwright.config.ts"
  ]
}
